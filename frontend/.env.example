# Local dev (copy to .env)
VITE_BACKEND_URL=http://localhost:4001
# Optional local Asgardeo overrides; otherwise see defaults in src/config/asgardeo.js
# VITE_ASGARDEO_CLIENT_ID=
# VITE_ASGARDEO_BASE_URL=
# VITE_ASGARDEO_SIGN_IN_REDIRECT_URL=http://localhost:5173
# VITE_ASGARDEO_SIGN_OUT_REDIRECT_URL=http://localhost:5173
# VITE_ASGARDEO_SCOPE=openid profile groups

# Production: copy to .env.production (Vite production mode / build)
# VITE_ASGARDEO_CLIENT_ID=<spa-client-id>
# VITE_ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<org>
# VITE_ASGARDEO_SCOPE=openid profile groups
# VITE_ASGARDEO_SIGN_IN_REDIRECT_URL=https://your-frontend.onrender.com
# VITE_ASGARDEO_SIGN_OUT_REDIRECT_URL=https://your-frontend.onrender.com
# VITE_BACKEND_URL=https://your-api.onrender.com
