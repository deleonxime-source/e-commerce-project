VITE_BACKEND_URL=http://localhost:4001
VITE_ASGARDEO_CLIENT_ID=<your-spa-client-id>
VITE_ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<your-org>

# Must match Asgardeo EXACTLY (Protocol → Authorized redirect + sign-out URLs). Register both local and prod if you use both.
# Local (`npm run dev` — values also set in .env for testing):
VITE_ASGARDEO_SIGN_IN_REDIRECT_URL=http://localhost:5173/products
VITE_ASGARDEO_SIGN_OUT_REDIRECT_URL=http://localhost:5173/products
# Production: put deploy URLs in `.env.production` or the host’s env (e.g. Render)

VITE_ASGARDEO_SCOPE=openid profile
