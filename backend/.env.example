PORT=4001
DATABASE_URL=postgresql://user:pass@host:5432/db

# Asgardeo JWT (org slug must match frontend baseUrl: .../t/<ASGARDEO_ORG>)
ASGARDEO_ORG=yourorg
# Optional overrides (defaults: JWKS = .../t/${ASGARDEO_ORG}/oauth2/jwks, iss = .../t/${ASGARDEO_ORG}, aud = SPA client id)
# ASGARDEO_JWKS_URI=
# ASGARDEO_ISSUER=
# ASGARDEO_AUDIENCE=
